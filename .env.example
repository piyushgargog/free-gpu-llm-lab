# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file (it is gitignored).

# Hugging Face token, needed to download gated models (e.g. google/gemma-3-4b-it)
# in the REMOTE Colab/Kaggle environment. Not needed on a local dev machine.
HF_TOKEN=

# Optional: cap web retrieval results per query (see src/free_gpu_llm/web)
WEB_SEARCH_MAX_RESULTS=5
